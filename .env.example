# Nombre visible de la aplicación.
VITE_APP_NAME="Facturación Electrónica SUNAT"

# Base de la API.
# En desarrollo se deja vacía: las peticiones salen como `/api/...` contra el
# propio origen y Vite las reenvía (ver `server.proxy` en vite.config.ts).
# En producción, si el front y la API viven en dominios distintos, aquí va la
# URL absoluta de la API (y hay que permitir ese origen en el CORS de Laravel).
VITE_API_BASE_URL=

# Destino al que el proxy de desarrollo reenvía `/api`.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Piloto sin datos reales de clientes (spec 009, A-43): «true» en staging y en el piloto.
VITE_PILOT_MODE=false
